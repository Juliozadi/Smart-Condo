# Copie para .env e ajuste. O .env não vai para o Git.

# Banco (documentação, seção 10.5: PostgreSQL)
DATABASE_URL=postgresql+psycopg://smartcondo:smartcondo@localhost:5432/smartcondo

# Gere uma chave própria, por exemplo com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-em-producao

# Ligado apenas em desenvolvimento. Com DEBUG=true o código de confirmação
# volta na resposta do cadastro (para testar sem provedor de e-mail/SMS) e
# o index.html aberto direto do disco (file://) é aceito pelo CORS.
DEBUG=true

ACCESS_TOKEN_EXPIRA_MIN=480
CODIGO_VERIFICACAO_EXPIRA_MIN=15
# Um código novo a cada CODIGO_INTERVALO_S segundos e no máximo
# CODIGO_MAX_POR_HORA por hora, por pessoa — contra disparos repetidos
# de e-mail e SMS (que é pago).
CODIGO_INTERVALO_S=60
CODIGO_MAX_POR_HORA=5
# Com quantos dias de antecedência, no máximo, o morador pode reservar.
RESERVA_ANTECEDENCIA_MAX_DIAS=180

# Custo do bcrypt (12 e o padrao seguro; nao baixe em producao)
BCRYPT_ROUNDS=12

# Origens liberadas no CORS. Em desenvolvimento qualquer porta local já é
# aceita pela expressão abaixo; em produção, esvazie a expressão e liste
# aqui o domínio real do front-end.
# CORS_ORIGINS=["https://smartcondo.exemplo.com"]
# CORS_ORIGIN_REGEX=

# ── Envio de e-mail ────────────────────────────────────────────────
# Sem SMTP_HOST o código de confirmação e o de recuperação de senha
# NÃO são entregues: ficam só no log. Em desenvolvimento tudo bem, o
# código volta na resposta da API enquanto DEBUG=true. Em produção
# isso trava o cadastro — o morador espera um código que nunca chega.
#
# Gmail: use uma "senha de app" (a senha normal da conta não funciona).
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORTA=587
#   SMTP_USUARIO=suaconta@gmail.com
#   SMTP_SENHA=a-senha-de-app-de-16-letras
#   SMTP_REMETENTE=SmartCondo <suaconta@gmail.com>
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_TLS=true
SMTP_REMETENTE=SmartCondo <nao-responda@smartcondo.com>
SMTP_TIMEOUT_S=10

# ── Envio de SMS (opcional, pago por mensagem) ─────────────────────
# Pelo Twilio (twilio.com). Com os três preenchidos, as telas de
# cadastro e de recuperação de senha passam a oferecer "receber por
# SMS". Vazios, só e-mail. SMS_REMETENTE é o número comprado no
# Twilio, no formato +5567999990000.
SMS_CONTA=
SMS_TOKEN=
SMS_REMETENTE=
SMS_TIMEOUT_S=10

# ── Arquivos enviados ──────────────────────────────────────────────
# Pasta onde fotos e documentos ficam (relativa a backend/) e o tamanho
# máximo de cada foto, em KB.
UPLOADS_DIR=uploads
FOTO_MAX_KB=2048
# Documentos do cadastro do morador: tamanho máximo (KB) e por quantos
# minutos depois do cadastro o envio continua liberado.
DOCUMENTO_MAX_KB=10240
TOKEN_DOCUMENTOS_MIN=60
# Dias que as fotos de visitantes e encomendas ficam guardadas (LGPD).
FOTO_PORTARIA_DIAS=90
